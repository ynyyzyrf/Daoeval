# Server-side integration API key. Generate a key with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Leave empty to disable /api/v1 (HTTP 503). Web APIs use administrator login.
AEVAL_API_KEY=

# Simple administrator login. Change either value and restart to apply.
AEVAL_ADMIN_USERNAME=admin
AEVAL_ADMIN_PASSWORD=admin
# Set true behind an HTTPS reverse proxy to use Secure session cookies.
# AEVAL_COOKIE_SECURE=true

# Local development defaults. Docker sets 0.0.0.0:3000 and /tmp/daoeval.
# AEVAL_HOST=127.0.0.1
# AEVAL_PORT=5280
# AEVAL_DATA_DIR=.data
# AEVAL_ENC_KEY=base64-encoded-32-byte-key
